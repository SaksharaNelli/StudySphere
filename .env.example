# MySQL (every service creates its own database automatically)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Shared secret used to sign and verify login tokens
JWT_SECRET=change-this-studysphere-secret

# Optional: enables Claude-powered answers in the AI Study Assistant (works offline without it)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
